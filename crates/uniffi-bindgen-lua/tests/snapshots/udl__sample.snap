/* Raises the Lua error for a failed call; `push_error` pushes the declared error. */
static UNIFFI_MAYBE_UNUSED int sample_raise(lua_State *L, RustCallStatus *status, void (*push_error)(lua_State *, RustBuffer)) {
    switch (status->code) {
        case UNIFFI_CALL_ERROR:
            if (push_error) {
                push_error(L, status->error_buf);
                return lua_error(L);
            }
            uniffi_buffer_free(status->error_buf);
            return luaL_error(L, "an unexpected error");
        case UNIFFI_CALL_UNEXPECTED_ERROR: {
            RustBuffer b = status->error_buf;
            lua_pushliteral(L, "rust panic: ");
            lua_pushlstring(L, b.data ? (const char *)b.data : "", (size_t)b.len);
            uniffi_buffer_free(b);
            lua_concat(L, 2);
            return lua_error(L);
        }
        case UNIFFI_CALL_CANCELLED:
            return luaL_error(L, "the call was cancelled");
        default:
            return luaL_error(L, "unknown call status %d", (int)status->code);
    }
}

