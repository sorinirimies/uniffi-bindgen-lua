static int sample_new_Thing_other(lua_State *L) {
    sample_enter(L);
    uint32_t v0 = (uint32_t)uniffi_lua_check_int(L, 1, 32, false, "Thing.other: argument 1 (n)");
    RustCallStatus uniffi_call = {0};
    uint64_t result = uniffi_sample_fn_constructor_thing_other(v0, &uniffi_call);
    if (uniffi_call.code != UNIFFI_CALL_SUCCESS) {
        return sample_raise(L, &uniffi_call, NULL);
    }
    sample_push_Thing(L, result);
    return 1;
}

static int sample_method_Thing_check(lua_State *L) {
    sample_enter(L);
    uint64_t self_handle = sample_handle_Thing(L, 1, "Thing:check: self");
    uint64_t self_lowered = sample_clone_Thing(self_handle);
    RustCallStatus uniffi_call = {0};
    uniffi_sample_fn_method_thing_check(self_lowered, &uniffi_call);
    if (uniffi_call.code != UNIFFI_CALL_SUCCESS) {
        return sample_raise(L, &uniffi_call, sample_push_error_Oops);
    }
    return 0;
}

static int sample_method_Thing_later(lua_State *L) {
    sample_enter(L);
    uint64_t self_handle = sample_handle_Thing(L, 1, "Thing:later: self");
    uint64_t self_lowered = sample_clone_Thing(self_handle);
    uint64_t future = uniffi_sample_fn_method_thing_later(self_lowered);
    uniffi_lua_block_on(&sample_dispatcher, future, (uniffi_poll_fn)ffi_sample_rust_future_poll_u32);
    RustCallStatus uniffi_call = {0};
    uint32_t result = ffi_sample_rust_future_complete_u32(future, &uniffi_call);
    ffi_sample_rust_future_free_u32(future);
    if (uniffi_call.code != UNIFFI_CALL_SUCCESS) {
        return sample_raise(L, &uniffi_call, NULL);
    }
    uniffi_lua_push_i64(L, (int64_t)result);
    return 1;
}

static int sample_method_Thing_name(lua_State *L) {
    sample_enter(L);
    uint64_t self_handle = sample_handle_Thing(L, 1, "Thing:name: self");
    uint64_t self_lowered = sample_clone_Thing(self_handle);
    RustCallStatus uniffi_call = {0};
    RustBuffer result = uniffi_sample_fn_method_thing_name(self_lowered, &uniffi_call);
    if (uniffi_call.code != UNIFFI_CALL_SUCCESS) {
        return sample_raise(L, &uniffi_call, NULL);
    }
    lua_pushlstring(L, result.data ? (const char *)result.data : "", (size_t)result.len);
    uniffi_buffer_free(result);
    return 1;
}

static int sample_poll(lua_State *L) {
    sample_enter(L);
    return 0;
}

