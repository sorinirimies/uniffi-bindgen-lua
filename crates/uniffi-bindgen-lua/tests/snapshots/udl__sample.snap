static void sample_to_wire_Oops(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    if (!lua_istable(L, idx)) {
        luaL_error(L, "%s: a table expected, got %s", what, luaL_typename(L, idx));
    }
    lua_getfield(L, idx, "tag");
    const char *tag = lua_tostring(L, -1);
    if (!tag) {
        luaL_error(L, "%s: the variant's name expected in field 'tag'", what);
    }
    if (strcmp(tag, "Bad") == 0) {
        lua_pop(L, 1);
        uniffi_write_i32(w, 1);
        return;
    }
    if (strcmp(tag, "Worse") == 0) {
        lua_pop(L, 1);
        uniffi_write_i32(w, 2);
        return;
    }
    luaL_error(L, "%s: '%s' is not a variant of Oops", what, tag);
}

static void sample_from_wire_Oops(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    lua_createtable(L, 0, 4);
    switch (uniffi_read_i32(r)) {
        case 1:
            lua_pushstring(L, "Bad");
            lua_setfield(L, -2, "tag");
            uniffi_lua_push_wire_string(L, r);
            lua_setfield(L, -2, "message");
            break;
        case 2:
            lua_pushstring(L, "Worse");
            lua_setfield(L, -2, "tag");
            uniffi_lua_push_wire_string(L, r);
            lua_setfield(L, -2, "message");
            break;
        default:
            r->failed = true;
    }
    luaL_getmetatable(L, "sample.Oops");
    lua_setmetatable(L, -2);
}

