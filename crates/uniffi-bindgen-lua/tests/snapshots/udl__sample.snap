static void sample_to_wire_Shape(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    if (!lua_istable(L, idx)) {
        luaL_error(L, "%s: a table expected, got %s", what, luaL_typename(L, idx));
    }
    lua_getfield(L, idx, "tag");
    const char *tag = lua_tostring(L, -1);
    if (!tag) {
        luaL_error(L, "%s: the variant's name expected in field 'tag'", what);
    }
    if (strcmp(tag, "Circle") == 0) {
        lua_pop(L, 1);
        uniffi_write_i32(w, 1);
        lua_getfield(L, idx, "center");
        if (lua_isnil(L, -1)) {
            luaL_error(L, "%s: field 'center' is missing", what);
        } else {
            int field = lua_gettop(L);
            sample_to_wire_Point(L, field, w, "Shape.Circle.center");
        }
        lua_pop(L, 1);
        lua_getfield(L, idx, "radius");
        if (lua_isnil(L, -1)) {
            luaL_error(L, "%s: field 'radius' is missing", what);
        } else {
            int field = lua_gettop(L);
            uniffi_write_f64(w, uniffi_lua_check_number(L, field, "Shape.Circle.radius"));
        }
        lua_pop(L, 1);
        return;
    }
    if (strcmp(tag, "Empty") == 0) {
        lua_pop(L, 1);
        uniffi_write_i32(w, 2);
        return;
    }
    luaL_error(L, "%s: '%s' is not a variant of Shape", what, tag);
}

static void sample_from_wire_Shape(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    lua_createtable(L, 0, 4);
    switch (uniffi_read_i32(r)) {
        case 1:
            lua_pushstring(L, "Circle");
            lua_setfield(L, -2, "tag");
            sample_from_wire_Point(L, r);
            lua_setfield(L, -2, "center");
            lua_pushnumber(L, (lua_Number)uniffi_read_f64(r));
            lua_setfield(L, -2, "radius");
            break;
        case 2:
            lua_pushstring(L, "Empty");
            lua_setfield(L, -2, "tag");
            break;
        default:
            r->failed = true;
    }
}

static void sample_to_wire_Point(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    if (!lua_istable(L, idx)) {
        luaL_error(L, "%s: a table expected, got %s", what, luaL_typename(L, idx));
    }
    lua_getfield(L, idx, "x");
    if (lua_isnil(L, -1)) {
        luaL_error(L, "%s: field 'x' is missing", what);
    } else {
        int field = lua_gettop(L);
        uniffi_write_f64(w, uniffi_lua_check_number(L, field, "Point.x"));
    }
    lua_pop(L, 1);
    lua_getfield(L, idx, "y");
    if (lua_isnil(L, -1)) {
        uniffi_write_f64(w, 1.5);
    } else {
        int field = lua_gettop(L);
        uniffi_write_f64(w, uniffi_lua_check_number(L, field, "Point.y"));
    }
    lua_pop(L, 1);
    lua_getfield(L, idx, "label");
    if (lua_isnil(L, -1)) {
        uniffi_write_i8(w, 0);
    } else {
        int field = lua_gettop(L);
        sample_to_wire_OptionString(L, field, w, "Point.label");
    }
    lua_pop(L, 1);
    lua_getfield(L, idx, "color");
    if (lua_isnil(L, -1)) {
        uniffi_write_i32(w, 2);
    } else {
        int field = lua_gettop(L);
        sample_to_wire_Color(L, field, w, "Point.color");
    }
    lua_pop(L, 1);
}

static void sample_from_wire_Point(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    lua_createtable(L, 0, 4);
    lua_pushnumber(L, (lua_Number)uniffi_read_f64(r));
    lua_setfield(L, -2, "x");
    lua_pushnumber(L, (lua_Number)uniffi_read_f64(r));
    lua_setfield(L, -2, "y");
    sample_from_wire_OptionString(L, r);
    lua_setfield(L, -2, "label");
    sample_from_wire_Color(L, r);
    lua_setfield(L, -2, "color");
}

static void sample_to_wire_SequenceOptionString(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    if (!lua_istable(L, idx)) {
        luaL_error(L, "%s: a table expected, got %s", what, luaL_typename(L, idx));
    }
    /* `n` (as table.pack sets it) counts trailing and inner nils, which `#` cannot. */
    size_t n = (size_t)lua_rawlen(L, idx);
    lua_getfield(L, idx, "n");
    if (uniffi_lua_isinteger(L, -1) && lua_tonumber(L, -1) >= 0) {
        n = (size_t)lua_tonumber(L, -1);
    }
    lua_pop(L, 1);
    uniffi_write_len(w, n);
    for (size_t i = 1; i <= n; ++i) {
        lua_rawgeti(L, idx, (int)i);
        int item = lua_gettop(L);
        sample_to_wire_OptionString(L, item, w, what);
        lua_pop(L, 1);
    }
}

static void sample_from_wire_SequenceOptionString(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    size_t n = uniffi_read_len(r, 1);
    lua_createtable(L, (int)n, 1);
    for (size_t i = 0; i < n && !r->failed; ++i) {
        sample_from_wire_OptionString(L, r);
        lua_rawseti(L, -2, (int)(i + 1));
    }
    uniffi_lua_push_i64(L, (int64_t)n);
    lua_setfield(L, -2, "n");
}

static void sample_to_wire_OptionString(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    if (lua_isnoneornil(L, idx)) {
        uniffi_write_i8(w, 0);
        return;
    }
    uniffi_write_i8(w, 1);
    {
        size_t n;
        const char *s = uniffi_lua_check_lstring(L, idx, &n, what);
        uniffi_write_len(w, n);
        uniffi_write_raw(w, s, n);
    }
}

static void sample_from_wire_OptionString(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    switch (uniffi_read_i8(r)) {
        case 1:
            uniffi_lua_push_wire_string(L, r);
            break;
        case 0:
            lua_pushnil(L);
            break;
        default:
            r->failed = true;
            lua_pushnil(L);
    }
}

static void sample_to_wire_MapStringU32(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    if (!lua_istable(L, idx)) {
        luaL_error(L, "%s: a table expected, got %s", what, luaL_typename(L, idx));
    }
    size_t n = 0;
    lua_pushnil(L);
    while (lua_next(L, idx)) {
        n++;
        lua_pop(L, 1);
    }
    uniffi_write_len(w, n);
    lua_pushnil(L);
    while (lua_next(L, idx)) {
        int key = lua_gettop(L) - 1;
        int value = lua_gettop(L);
        {
        size_t n;
        const char *s = uniffi_lua_check_lstring(L, key, &n, what);
        uniffi_write_len(w, n);
        uniffi_write_raw(w, s, n);
    }
        uniffi_write_u32(w, (uint32_t)uniffi_lua_check_int(L, value, 32, false, what));
        lua_pop(L, 1);
    }
}

static void sample_from_wire_MapStringU32(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    size_t n = uniffi_read_len(r, 8);
    lua_createtable(L, 0, (int)n);
    for (size_t i = 0; i < n && !r->failed; ++i) {
        uniffi_lua_push_wire_string(L, r);
        uniffi_lua_push_i64(L, (int64_t)uniffi_read_u32(r));
        lua_settable(L, -3);
    }
}

static void sample_to_wire_Color(lua_State *L, int idx, uniffi_writer *w, const char *what) {
    (void)what;
    (void)w;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    const char *tag = uniffi_lua_check_lstring(L, idx, NULL, what);
    if (strcmp(tag, "Red") == 0) {
        uniffi_write_i32(w, 1);
        return;
    }
    if (strcmp(tag, "Green") == 0) {
        uniffi_write_i32(w, 2);
        return;
    }
    luaL_error(L, "%s: '%s' is not a variant of Color", what, tag);
}

static void sample_from_wire_Color(lua_State *L, uniffi_reader *r) {
    (void)r;
    luaL_checkstack(L, 8, "uniffi: values nested too deeply");
    switch (uniffi_read_i32(r)) {
        case 1: lua_pushstring(L, "Red"); break;
        case 2: lua_pushstring(L, "Green"); break;
        default: r->failed = true; lua_pushnil(L);
    }
}

typedef struct sample_Sink_m0_call {
    uint64_t handle;
    RustBuffer arg0;
    RustCallStatus status;
} sample_Sink_m0_call;

static int sample_Sink_m0_protected(lua_State *L) {
    sample_Sink_m0_call *c = (sample_Sink_m0_call *)lua_touserdata(L, 1);
    int ref = sample_ref_Sink(c->handle);
    if (ref == LUA_NOREF) {
        return luaL_error(L, "the object was released already");
    }
    lua_rawgeti(L, LUA_REGISTRYINDEX, ref);
    lua_getfield(L, -1, "push");
    if (!lua_isfunction(L, -1)) {
        return luaL_error(L, "the implementation has no method '%s'", "push");
    }
    lua_pushvalue(L, -2);
    lua_pushlstring(L, c->arg0.data ? (const char *)c->arg0.data : "", (size_t)c->arg0.len);
    lua_call(L, 2, 0);
    return 0;
}

static void sample_Sink_m0_body(lua_State *L, sample_Sink_m0_call *c) {
    int top = lua_gettop(L);
    lua_pushcfunction(L, sample_Sink_m0_protected);
    lua_pushlightuserdata(L, c);
    if (lua_pcall(L, 1, 0, 0) != LUA_OK) {
        int handled = 0;
        if (!handled) {
            size_t n = 0;
            const char *message = uniffi_lua_error_message(L, -1, &n);
            c->status.code = UNIFFI_CALL_UNEXPECTED_ERROR;
            c->status.error_buf = uniffi_buffer_from(message, n);
        }
    }
    lua_settop(L, top);
    uniffi_buffer_free(c->arg0);
}

static void sample_Sink_m0_detached(lua_State *L, void *raw) {
    sample_Sink_m0_call *c = (sample_Sink_m0_call *)raw;
    sample_Sink_m0_body(L, c);
    if (c->status.code != UNIFFI_CALL_SUCCESS) {
        fprintf(stderr, "uniffi: a push callback failed: %.*s\n", (int)c->status.error_buf.len, c->status.error_buf.data ? (const char *)c->status.error_buf.data : "");
        uniffi_buffer_free(c->status.error_buf);
    }
    free(c);
}

static void sample_Sink_m0(uint64_t uniffi_handle, RustBuffer arg0, void * uniffi_out_return, RustCallStatus * uniffi_call_status) {
    (void)uniffi_out_return;
    if (!uniffi_lua_on_owner(&sample_dispatcher)) {
        sample_Sink_m0_call *c = (sample_Sink_m0_call *)uniffi_alloc(sizeof *c);
        c->handle = uniffi_handle;
        c->arg0 = arg0;
        uniffi_lua_invoke(&sample_dispatcher, sample_Sink_m0_detached, c, true);
        return;
    }
    sample_Sink_m0_call call;
    memset(&call, 0, sizeof call);
    sample_Sink_m0_call *c = &call;
    c->handle = uniffi_handle;
    c->arg0 = arg0;
    sample_Sink_m0_body(sample_dispatcher.L, c);
    *uniffi_call_status = c->status;
}

typedef struct sample_Sink_m1_call {
    uint64_t handle;
    uint32_t result;
    RustCallStatus status;
} sample_Sink_m1_call;

static int sample_Sink_m1_protected(lua_State *L) {
    sample_Sink_m1_call *c = (sample_Sink_m1_call *)lua_touserdata(L, 1);
    int ref = sample_ref_Sink(c->handle);
    if (ref == LUA_NOREF) {
        return luaL_error(L, "the object was released already");
    }
    lua_rawgeti(L, LUA_REGISTRYINDEX, ref);
    lua_getfield(L, -1, "count");
    if (!lua_isfunction(L, -1)) {
        return luaL_error(L, "the implementation has no method '%s'", "count");
    }
    lua_pushvalue(L, -2);
    lua_call(L, 1, 1);
    c->result = (uint32_t)uniffi_lua_check_int(L, -1, 32, false, "count: result");
    return 0;
}

static int sample_Sink_m1_error(lua_State *L) {
    sample_Sink_m1_call *c = (sample_Sink_m1_call *)lua_touserdata(L, 2);
    uniffi_writer *w = uniffi_lua_writer(L);
    sample_to_wire_Oops(L, 1, w, "the error");
    c->status.error_buf = uniffi_buffer_from(w->data, w->len);
    uniffi_writer_free(w);
    c->status.code = UNIFFI_CALL_ERROR;
    return 0;
}

static void sample_Sink_m1_body(lua_State *L, sample_Sink_m1_call *c) {
    int top = lua_gettop(L);
    lua_pushcfunction(L, sample_Sink_m1_protected);
    lua_pushlightuserdata(L, c);
    if (lua_pcall(L, 1, 0, 0) != LUA_OK) {
        int handled = 0;
        if (lua_istable(L, -1) || lua_isuserdata(L, -1)) {
            lua_pushcfunction(L, sample_Sink_m1_error);
            lua_pushvalue(L, -2);
            lua_pushlightuserdata(L, c);
            handled = lua_pcall(L, 2, 0, 0) == LUA_OK;
            if (!handled) {
                lua_pop(L, 1);
            }
        }
        if (!handled) {
            size_t n = 0;
            const char *message = uniffi_lua_error_message(L, -1, &n);
            c->status.code = UNIFFI_CALL_UNEXPECTED_ERROR;
            c->status.error_buf = uniffi_buffer_from(message, n);
        }
    }
    lua_settop(L, top);
}

static void sample_Sink_m1_run(lua_State *L, void *raw) {
    sample_Sink_m1_body(L, (sample_Sink_m1_call *)raw);
}

static void sample_Sink_m1(uint64_t uniffi_handle, uint32_t * uniffi_out_return, RustCallStatus * uniffi_call_status) {
    sample_Sink_m1_call call;
    memset(&call, 0, sizeof call);
    sample_Sink_m1_call *c = &call;
    c->handle = uniffi_handle;
    uniffi_lua_invoke(&sample_dispatcher, sample_Sink_m1_run, c, false);
    *uniffi_call_status = c->status;
    *uniffi_out_return = c->result;
}

static void sample_Sink_init(void) {
    static VTableCallbackInterfaceSink vtable = {sample_Sink_vtable_free, sample_Sink_vtable_clone, sample_Sink_m0, sample_Sink_m1};
    uniffi_sample_fn_init_callback_vtable_sink(&vtable);
}

static void sample_push_error_Oops(lua_State *L, RustBuffer buffer) {
    uniffi_reader reader = uniffi_reader_new(buffer.data, (size_t)buffer.len);
    uniffi_reader *r = &reader;
    sample_from_wire_Oops(L, r);
    bool bad = reader.failed;
    uniffi_buffer_free(buffer);
    if (bad) {
        lua_pop(L, 1);
        lua_pushliteral(L, "Rust sent a malformed error");
    }
}

static int sample_fn_add(lua_State *L) {
    sample_enter(L);
    uint32_t v0 = (uint32_t)uniffi_lua_check_int(L, 1, 32, false, "add: argument 1 (a)");
    uint32_t v1 = (uint32_t)uniffi_lua_check_int(L, 2, 32, false, "add: argument 2 (b)");
    RustCallStatus uniffi_call = {0};
    uint32_t result = uniffi_sample_fn_func_add(v0, v1, &uniffi_call);
    if (uniffi_call.code != UNIFFI_CALL_SUCCESS) {
        return sample_raise(L, &uniffi_call, NULL);
    }
    uniffi_lua_push_i64(L, (int64_t)result);
    return 1;
}

static int sample_fn_counts(lua_State *L) {
    sample_enter(L);
    RustCallStatus uniffi_call = {0};
    RustBuffer result = uniffi_sample_fn_func_counts(&uniffi_call);
    if (uniffi_call.code != UNIFFI_CALL_SUCCESS) {
        return sample_raise(L, &uniffi_call, NULL);
    }
    {
        uniffi_reader reader = uniffi_reader_new(result.data, (size_t)result.len);
        uniffi_reader *r = &reader;
        sample_from_wire_MapStringU32(L, r);
        bool bad = reader.failed || uniffi_reader_remaining(&reader) != 0;
        uniffi_buffer_free(result);
        if (bad) {
            return luaL_error(L, "%s: Rust sent a malformed value", "counts");
        }
    }
    return 1;
}

